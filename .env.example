APP_MODE=demo
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recoverai
PAYMENT_PROVIDER=mock
NOTIFICATION_PROVIDER=simulation
NOTIFICATION_MODE=simulation # Options: simulation | real
RAZORPAY_KEY_ID=mock_key_id
RAZORPAY_KEY_SECRET=mock_key_secret
WEBHOOK_SHARED_SECRET=mock_webhook_secret
DEFAULT_AUTO_RECOVERY_ENABLED=true
DEFAULT_MAX_AUTO_RECOVERY_AMOUNT=5000
DEFAULT_MAX_RETRY_ATTEMPTS=2
DEFAULT_RETRY_DELAY_MINUTES=60

# Twilio Configuration (Required when NOTIFICATION_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_SMS=your_twilio_sms_sender_number_here
TWILIO_FROM_WHATSAPP=your_twilio_whatsapp_sender_number_here
CUSTOMER_PORTAL_BASE_URL=http://localhost:3000
TEST_RECIPIENT_PHONE=your_verified_twilio_recipient_phone_number_here
